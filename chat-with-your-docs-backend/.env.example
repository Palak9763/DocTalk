# ==========================================
# Chat With Your Docs - Environment Settings
# ==========================================

# Directory Paths
NOTES_DIR=data/notes
LIBRARY_DIR=data/library
INDEX_DIR=index

# Model Settings
OLLAMA_HOST=http://localhost:11434
CHAT_MODEL=qwen2.5:3b-instruct
EMBED_MODEL=nomic-embed-text
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EVAL_JUDGE_MODEL=qwen2.5:3b-instruct
# EVAL_JUDGE_MODEL=qwen2.5:14b

# Speed & Capacity Knobs
NUM_CTX=6144
KEEP_ALIVE=30m
MAX_ANSWER_TOKENS=600
RERANK_MAX_LEN=384
RERANK_TOP_N=50
ANN_MIN_CHUNKS=20000
